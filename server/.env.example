# ==============================================================================
# YKB Clothing - Server Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the real .env file or real secrets to source control.
# ==============================================================================

# Server Network & Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (TiDB Cloud / MySQL 8.0+)
# TiDB Cloud requires SSL TLSv1.2+
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=ykb_clothing
DB_PORT=4000

# Authentication (JWT)
# Must be at least 32 characters long cryptographically random string
JWT_SECRET=your_minimum_32_characters_random_secret_key_here

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# PayMongo Payment Gateway (Use test keys: pk_test_... / sk_test_...)
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
PAYMONGO_WEBHOOK_SECRET=whsec_your_paymongo_webhook_secret

# Email Service Provider (Password Resets & Notifications)
# Supported options: SMTP or RESEND_API_KEY or BREVO_API_KEY
# Option A - SMTP:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_username
SMTP_PASS=smtp_password
SMTP_FROM="YKB Clothing <support@ykbclothing.com>"

# Option B - Resend API:
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM="YKB Clothing <support@ykbclothing.com>"

# Option C - Brevo API:
# BREVO_API_KEY=xkeysib-your_api_key_here
# BREVO_FROM="YKB Clothing <support@ykbclothing.com>"

